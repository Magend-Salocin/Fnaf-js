{
  "name": "fnaf-js-electron",
  "version": "1.0.0",
  "description": "FNAF Remake",
  "main": "main.js",
  "scripts": {
    "start": "node tools/start.js",
    "build": "electron-builder",
    "doc:pdf": "node tools/impression/imprimer_doc.js",
    "web": "node tools/web-server.js",
    "build-web": "node tools/build-web.js",
    "key": "node tools/access-key.js"
  },
  "build": {
    "appId": "com.fnaf.remake",
    "productName": "FNAF Remake",
    "files": [
      "**/*",
      "!_site/**",
      "!*.local.pem",
      "!*.local.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.2.0",
    "mermaid": "^11.4.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true,
    "sharp@0.34.4": true
  }
}
